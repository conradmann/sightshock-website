---
const recipient = import.meta.env.PUBLIC_FORMSUBMIT_RECIPIENT?.trim() || '';
const configured = Boolean(recipient) && !/[\s/]/.test(recipient);
const action = configured ? `https://formsubmit.co/${recipient}` : undefined;
---
<form class="contact-form" action={action} method="POST" data-contact-form>
  <input type="hidden" name="_subject" value="New SightShock website inquiry" />
  <input type="hidden" name="_template" value="table" />
  <div class="form-row">
    <label>Name <input name="name" type="text" autocomplete="name" required placeholder="Your name" /></label>
    <label>Company <input name="company" type="text" autocomplete="organization" placeholder="Your organization" /></label>
  </div>
  <label>Email <input name="email" type="email" autocomplete="email" required placeholder="you@company.com" /></label>
  <label>Message <textarea name="message" rows="5" required placeholder="Tell us what you're working through..."></textarea></label>
  <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="honeypot" aria-hidden="true" />
  <div class="form-submit"><button class="button button-accent" type="submit" disabled={!configured}>Send inquiry <span aria-hidden="true">↗</span></button><p class="form-note">{configured ? 'Your message will be sent to SightShock.' : 'Contact form setup is pending. Submissions are not live yet.'}</p></div>
</form>
