  <div class="shell footer-bottom"><span>© {new Date().getFullYear()} SightShock. All rights reserved.</span><nav aria-label="Footer navigation">{navigation.map(({ label, href }) => <a href={href}>{label}</a>)}</nav><a href="#top">Back to top ↑</a></div>
</footer>
