---
const { hero = false } = Astro.props;
---
<div class:list={['network-diagram', { 'hero-diagram': hero }]} aria-hidden="true">
  <div class="diagram-topline"><span>SS / SYSTEM MAP</span><span>LIVE ARCHITECTURE</span></div>
  <svg viewBox="0 0 640 440" role="presentation" focusable="false">
    <defs>
      <pattern id={hero ? 'grid-hero' : 'grid-service'} width="36" height="36" patternUnits="userSpaceOnUse"><path d="M36 0H0V36" fill="none" stroke="currentColor" stroke-opacity=".11" stroke-width="1"/></pattern>
      <linearGradient id={hero ? 'line-hero' : 'line-service'} x1="0" y1="0" x2="1" y2="1"><stop stop-color="#c8f58b" stop-opacity=".15"/><stop offset=".55" stop-color="#c8f58b" stop-opacity=".85"/><stop offset="1" stop-color="#c8f58b" stop-opacity=".12"/></linearGradient>
    </defs>
    <rect width="640" height="440" fill={`url(#${hero ? 'grid-hero' : 'grid-service'})`}/>
    <g class="diagram-orbit"><circle cx="322" cy="220" r="160" fill="none" stroke="currentColor" stroke-opacity=".15" stroke-dasharray="3 7"/><circle cx="322" cy="220" r="99" fill="none" stroke="currentColor" stroke-opacity=".12"/></g>
    <g class="diagram-lines" fill="none" stroke={`url(#${hero ? 'line-hero' : 'line-service'})`} stroke-width="1.5">
      <path d="M322 220L132 118M322 220L510 112M322 220L518 328M322 220L126 334M322 220L322 58M322 220L322 384"/>
      <path d="M132 118L322 58L510 112M510 112L518 328L322 384L126 334L132 118" stroke-opacity=".5"/>
    </g>
    <g class="diagram-nodes" fill="#0d171c" stroke="#7d9e77" stroke-width="1.5">
      <circle class="node node-a" cx="132" cy="118" r="18"/><circle class="node node-b" cx="510" cy="112" r="18"/><circle class="node node-c" cx="518" cy="328" r="18"/><circle class="node node-d" cx="126" cy="334" r="18"/><circle class="node node-e" cx="322" cy="58" r="14"/><circle class="node node-f" cx="322" cy="384" r="14"/>
      <circle class="core-ring" cx="322" cy="220" r="45" stroke="#c8f58b" stroke-opacity=".6"/><circle class="core" cx="322" cy="220" r="27" fill="#c8f58b" stroke="#c8f58b"/>
    </g>
    <g fill="#a9b7ad" font-family="monospace" font-size="11" letter-spacing="2"><text x="94" y="84">CLOUD</text><text x="478" y="75">PLATFORM</text><text x="482" y="375">SIGNALS</text><text x="75" y="380">AUTOMATION</text><text x="342" y="222" fill="#eaf3e8">CORE</text></g>
    <path class="diagram-pulse" d="M132 118L322 220L518 328" fill="none" stroke="#c8f58b" stroke-width="2" stroke-linecap="round"/>
  </svg>
  <div class="diagram-bottomline"><span>CONNECTED SYSTEMS</span><span class="diagram-status"><i></i> OPERATIONAL</span></div>
</div>
